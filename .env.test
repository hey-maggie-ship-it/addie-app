# Dummy public values so `vite build --mode test` succeeds in CI without secrets.
# These are NOT real — the smoke test only checks that the app boots and renders
# the signed-out screen. Production uses Vercel env vars (default mode).
VITE_SUPABASE_URL=https://example.supabase.co
VITE_SUPABASE_ANON_KEY=test-anon-key-not-real
