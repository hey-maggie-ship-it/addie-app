# ──────────────────────────────────────────────────────────
# Copy this file to ".env.local" and fill in real values for local dev.
# In production, set these in Vercel → Settings → Environment Variables.
# ──────────────────────────────────────────────────────────

# Secret — server-side only (used by api/chat.js). NEVER prefix with VITE_.
ANTHROPIC_KEY=sk-ant-...

# Public — safe in the browser. Security comes from Supabase RLS policies.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
